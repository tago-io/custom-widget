{
  "name": "@tago-io/custom-widget",
  "version": "2.0.1",
  "description": "TagoIO Toolkit to build your own widgets",
  "keywords": [
    "custom-widget",
    "dashboard",
    "iot",
    "javascript",
    "tago",
    "tagoio",
    "widget"
  ],
  "homepage": "https://github.com/tago-io/custom-widget#readme",
  "bugs": "https://github.com/tago-io/custom-widget/issues",
  "license": "Apache-2.0",
  "author": "TagoIO Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/tago-io/custom-widget.git",
    "directory": "packages/js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/custom-widget.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:scripts": "tsup",
    "build:css": "lessc ./src/css/custom-widget.less ./dist/custom-widget.css",
    "build:cssmin": "cleancss -o ./dist/custom-widget.min.css ./dist/custom-widget.css",
    "build": "pnpm run build:scripts && pnpm run build:css && pnpm run build:cssmin",
    "test": "vp test run",
    "coverage": "vp test run --coverage",
    "check:types": "tsc --noEmit",
    "lint": "vp lint src/",
    "lint:fix": "vp lint --fix src/",
    "format": "vp fmt src/"
  },
  "dependencies": {
    "@tago-io/custom-widget-core": "workspace:*"
  },
  "devDependencies": {
    "clean-css-cli": "5.6.3",
    "less": "4.6.4",
    "tsup": "8.5.0"
  }
}
