{
  "name": "@tago-io/custom-widget-react",
  "version": "0.1.0",
  "description": "React SDK for TagoIO Custom Widgets",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "author": "Tago LLC",
  "license": "Apache-2.0",
  "repository": "tago-io/custom-widget",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@tago-io/custom-widget-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "8.5.0"
  }
}
