{
  "name": "@tago-io/custom-widget-core",
  "version": "2.2.0",
  "description": "Framework-agnostic core for TagoIO Custom Widget SDKs",
  "keywords": [
    "custom-widget",
    "dashboard",
    "iot",
    "tago",
    "tagoio",
    "widget"
  ],
  "homepage": "https://github.com/tago-io/custom-widget#readme",
  "bugs": "https://github.com/tago-io/custom-widget/issues",
  "license": "Apache-2.0",
  "author": "TagoIO Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/tago-io/custom-widget.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vp test run",
    "check:types": "tsc --noEmit",
    "lint": "vp lint src/",
    "format": "vp fmt src/"
  },
  "devDependencies": {
    "tsup": "8.5.1"
  }
}
