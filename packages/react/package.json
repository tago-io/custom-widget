{
  "name": "@tago-io/custom-widget-react",
  "version": "2.0.0",
  "description": "React SDK for TagoIO Custom Widgets",
  "keywords": [
    "custom-widget",
    "dashboard",
    "hooks",
    "iot",
    "react",
    "tago",
    "tagoio",
    "widget"
  ],
  "homepage": "https://github.com/tago-io/custom-widget#readme",
  "bugs": "https://github.com/tago-io/custom-widget/issues",
  "license": "Apache-2.0",
  "author": "Tago LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/tago-io/custom-widget.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vp test run",
    "check:types": "tsc --noEmit",
    "lint": "vp lint src/",
    "format": "vp fmt src/"
  },
  "dependencies": {
    "@tago-io/custom-widget-core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "8.5.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
