      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@changesets/cli": "~2.30.0",
    "@vitest/coverage-v8": "4.1.0",
    "jsdom": "29.0.0",
    "turbo": "2.8.19",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "vitest": "4.1.0"
  }
}
